{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Modelo",
  "mainBinaryName": "modelo",
  "version": "0.1.0",
  "identifier": "com.danilolemos.modelo",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Modelo",
        "width": 1100,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "category": "Video",
    "shortDescription": "Modelo de app desktop",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": { "language": "pt-BR" },
      "nsis": { "languages": ["PortugueseBR"] }
    }
  }
}
