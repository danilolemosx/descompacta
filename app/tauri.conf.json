{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Descompacta",
  "mainBinaryName": "descompacta",
  "version": "0.1.0",
  "identifier": "com.danilolemos.descompacta",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Descompacta",
        "width": 560,
        "height": 720,
        "minWidth": 460,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis"
    ],
    "category": "Utility",
    "shortDescription": "Descompacta e compacta arquivos (zip, rar, 7z e outros)",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {
        "language": "pt-BR"
      },
      "nsis": {
        "languages": [
          "PortugueseBR"
        ]
      }
    },
    "externalBin": [
      "binaries/7zz"
    ],
    "resources": {
      "binaries/7zip-License.txt": "7zip-License.txt"
    }
  }
}
